# ── Phase 1 local cluster settings ───────────────────────────────────────────
# Copy to .env (the up.sh script does this for you on first run):
#   cp .env.example .env

# Image tag. Default "latest" guarantees the pull works on first run.
# For production, PIN to a specific version (current stable: 15.2.0) and bump
# deliberately. Tags: https://hub.docker.com/r/technitium/dns-server/tags
TECHNITIUM_TAG=latest

# Web console admin password. LOCAL POC ONLY — do not reuse anywhere real.
ADMIN_PASSWORD=changeme-local-only

# Cluster domain you'll enter in the UI during "Initialize > New Cluster".
# Can be private (won't resolve publicly).
CLUSTER_DOMAIN=dns.example.com
